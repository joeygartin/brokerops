# brokerops — environment template
# Copy to .env for local development (.env is gitignored).
# Demo mode (`docker compose up`) requires NONE of these to be set.
#
# docker compose interpolates .env: every integration var defaults to the
# bundled in-network stub, so leave the overrides below COMMENTED OUT unless
# you are flipping that integration to its real counterpart. (Uncommented
# localhost URLs would override the in-network stub DNS and break compose.)

# ── Database (plain DSN — the app derives driver-specific URLs) ───────
DATABASE_URL=postgresql://brokerops:brokerops@localhost:5432/brokerops_demo

# ── Orchestration engine ──────────────────────────────────────────────
# langgraph (V1 default) or adk (V2). Same workflows, approvals, and API
# surface either way; neither needs an LLM key for the demo workflows.
ORCHESTRATOR=langgraph

# ── Tenant identity (BOP-006) ─────────────────────────────────────────
# This deploy's tenant — bound below the agent around every request so the
# data layer confines reads/writes to it. brokerops is single-tenant per
# deploy; Terraform sets this from the client name for client deploys. Leave
# as "demo" for local/compose.
TENANT_ID=demo

# ── MLS (RESO Web API) ────────────────────────────────────────────────
# Default: the bundled mock (http://mls:8001 in compose, no token needed).
# For a live RESO endpoint, set its base URL and a bearer token:
#RESO_BASE_URL=https://reso.example-mls.test/odata
#RESO_AUTH_TOKEN=fake-reso-bearer-token

# ── CRM vendor selector (ADR-0016) ────────────────────────────────────
# Which CRM this deploy is wired to: followupboss (default) or sierra.
# Explicit and fail-loud (the ORCHESTRATOR/EXTRACTION_BACKEND posture): an
# unknown value refuses to start, and sierra with missing config refuses to
# start rather than silently running FollowUpBoss.
#CRM_VENDOR=followupboss

# ── FollowUpBoss CRM ──────────────────────────────────────────────────
# Default: the bundled stub (http://fub:8002 in compose, any key works).
# For a real FUB account, set the real key and the real API base:
#FUB_API_KEY=fake-fub-key
#FUB_BASE_URL=https://api.followupboss.com/v1

# ── Sierra Interactive CRM (CRM_VENDOR=sierra) ────────────────────────
# SIERRA_BASE_URL=internal mounts the bundled stub in-process (no key).
# Against the real API all four values are required at startup: Sierra tasks
# are always assigned to an admin user (SIERRA_TASK_ASSIGNEE_ID) and always
# attached to a lead — tasks created without a contact anchor to
# SIERRA_TASK_ANCHOR_LEAD_ID (a designated operations lead record). ADR-0016.
#SIERRA_API_KEY=fake-sierra-key
#SIERRA_BASE_URL=internal
#SIERRA_TASK_ASSIGNEE_ID=4321
#SIERRA_TASK_ANCHOR_LEAD_ID=501

# ── Vapi voice ────────────────────────────────────────────────────────
# Default: the bundled stub (http://vapi:8003 in compose, any key works).
# For a real Vapi account, set the real key + assistant id and the real
# API base, and point the Vapi webhook at /webhooks/vapi with the secret.
# The webhook fails closed: with no VAPI_WEBHOOK_SECRET set it rejects every
# request (500), so a value is required wherever the webhook is reachable —
# compose defaults one, and the in-process stub shares it automatically.
#VAPI_API_KEY=fake-vapi-key
#VAPI_BASE_URL=https://api.vapi.ai
#VAPI_ASSISTANT_ID=demo-assistant
#VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
#VAPI_WEBHOOK_SECRET=fake-webhook-secret

# ── Office files (Google Drive) ───────────────────────────────────────
# Explicit closed selector (BOP-021): FILES_PROVIDER is stub | google_drive.
# Default (unset/stub): the bundled in-memory Drive double seeded with
# synthetic transaction folders — zero credentials (http://drive:8004 in
# compose). google_drive flips to the real Drive API and REQUIRES a per-client
# service-account JSON (mount it from Secret Manager — never the repo); naming
# it without credentials fails loud at startup rather than silently
# downgrading. Folder convention: one Drive folder per listing key (see
# docs/CLIENT_ONBOARDING.md → Office files).
# GOOGLE_DRIVE_ROOT_FOLDER_ID anchors folder lookup/creation under ONE Drive
# folder (the id in the folder's URL). Strongly recommended on real deploys:
# Drive allows duplicate folder names anywhere the service account can see, so
# an unanchored name lookup could resolve into an unrelated corner of the
# corpus. Unset = drive-wide lookup (oldest match wins, duplicates logged).
#FILES_PROVIDER=google_drive
#GOOGLE_DRIVE_CREDENTIALS_FILE=/secrets/drive-credentials.json
#GOOGLE_DRIVE_ROOT_FOLDER_ID=your-drive-folder-id
#GOOGLE_DRIVE_BASE_URL=https://www.googleapis.com

# ── Demo data routes (optional; demo only) ────────────────────────────
# The /demo/* seed/reset routes can wipe this tenant's transactions, so they are
# mounted ONLY when this is set — otherwise the routes are absent entirely (404,
# no OpenAPI entry). `docker compose up` turns them on for the local demo; a real
# client deploy leaves this unset.
#ENABLE_DEMO_ROUTES=true

# ── GCP deploy (per-client Terraform; see infra/) ─────────────────────
# Created by infra/bootstrap/bootstrap.sh; used by `make deploy`.
TF_STATE_BUCKET=your-brokerops-tf-state-bucket
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-west1

# ── Cron protection (optional) ────────────────────────────────────────
# When set, POST /internal/cron/milestones requires the X-Cron-Key header.
# Unset = open (demo mode). GCP deploys use Cloud Run OIDC instead.
CRON_SECRET=

# ── Operator authentication (optional) ────────────────────────────────
# Default (unset): the dashboard + API run under a single demo operator with
# no login — demo mode stays zero-credential (ADR-0007/0008). Pick one or both
# login methods with AUTH_METHODS; restrict who may sign in by Workspace domain
# and/or an explicit email allowlist (shared by both methods).
#AUTH_METHODS=google,magic
#AUTH_ALLOWED_DOMAIN=example.com
#AUTH_ALLOWED_EMAILS=alice@example.com,bob@example.com
#
# RBAC (ADR-0009): assign roles among the allowlisted operators. With none of the
# four set, every signed-in operator is an admin (= pre-RBAC behavior). Admins
# decide HITL approvals; viewers are read-only; unmatched emails are operators.
#AUTH_ADMIN_EMAILS=alice@example.com
#AUTH_ADMIN_DOMAIN=example.com
#AUTH_VIEWER_EMAILS=auditor@example.com
#AUTH_VIEWER_DOMAIN=contractors.example.com
#
# google: set a Google OAuth *web* client id (public — a plain var, not a secret):
#GOOGLE_OIDC_CLIENT_ID=your-client-id.apps.googleusercontent.com
#
# magic (email sign-in links): needs a session signing key and the public URL of
# the frontend (for the emailed link). With no SMTP host, the link is logged to
# the api console (read it from the logs) — so magic link works locally with no
# email provider. Set SMTP_* to actually send.
#SESSION_SIGNING_KEY=generate-a-long-random-string
#PUBLIC_BASE_URL=http://localhost:5173
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_FROM=no-reply@brokerops.app
#SMTP_USERNAME=apikey
#SMTP_PASSWORD=your-smtp-password

# ── LLM feedback extraction (optional) ────────────────────────────────
# Backend selection is EXPLICIT (ADR-0014): EXTRACTION_BACKEND is a closed
# enum — deterministic | llm | pydantic_ai. Default (unset): deterministic
# keyword/pattern extraction — demo mode runs with zero credentials. A key
# alone no longer selects an LLM backend; naming an LLM backend without a
# real LLM_API_KEY fails loud at startup rather than silently downgrading.
#   llm         — raw-SDK Claude adapter (ADR-0006); default claude-sonnet-4-6
#   pydantic_ai — PydanticAI agent adapter (ADR-0014); default claude-sonnet-5
# LLM_MODEL overrides the selected backend's default (bare Claude model id).
#EXTRACTION_BACKEND=pydantic_ai
#LLM_API_KEY=fake-anthropic-key
#LLM_MODEL=claude-sonnet-5

# ── Outbound business email (BOP-015 / ADR-0015) ─────────────────────
# The client-facing comms channel (EmailPort) — NOT the magic-link SMTP above.
# Provider selection is EXPLICIT (ADR-0014 posture): EMAIL_PROVIDER is a closed
# enum — stub | ses | sendgrid. Default (unset): the bundled stub, which runs
# in-process (EMAIL_BASE_URL defaults to the `internal` sentinel) and prints
# each send to the api logs — demo mode stays zero-credential. An unknown value
# fails loud at startup; ses/sendgrid fail loud until their adapters land
# (BOP-016/017). EMAIL_BASE_URL points the stub adapter at an external
# stub-shaped endpoint instead of the in-process one (tests/tooling).
#EMAIL_PROVIDER=stub
#EMAIL_BASE_URL=internal

# ── LangSmith tracing (optional, off by default) ──────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=fake-langsmith-key
LANGCHAIN_PROJECT=brokerops-local
