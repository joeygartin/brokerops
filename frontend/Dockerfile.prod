# Production frontend image: build the static bundle, serve it with nginx on
# 8080 (Cloud Run's default port). The bundle calls the API same-origin at
# /api; nginx proxies that to API_UPSTREAM (env, set per deploy) — one image
# works for every client.
FROM node:20-slim AS build
WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .
ENV VITE_API_BASE=/api
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
ENV API_UPSTREAM=http://localhost:8000
EXPOSE 8080
